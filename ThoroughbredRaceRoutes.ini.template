[Circuit]
; Metres from the recorded centreline, on either side. Crossing it forfeits immediately.
TrackHalfWidth=12
HeightTolerance=6
; Laps of the loop beyond the first; a range draws at random. 2/2 = three times round.
ExtraLapsMin=2
ExtraLapsMax=2
; Rolling minimap guidance: the stretch ahead and a short tail behind.
GuideAheadMetres=200
GuideBehindMetres=12
