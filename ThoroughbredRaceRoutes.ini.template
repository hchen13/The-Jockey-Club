; Thoroughbred circuit - TEMPLATE. Becomes ThoroughbredRaceRoutes.ini in the
; game directory once every TODO is filled from a recording; until then the
; station stays off the map (a file that does not parse is ignored, and the
; log says "route config thoroughbred-circuit: rejected ...").
;
; The layout is the Valentine circuit's (CharlesRaceRoutes.ini): a multi-lap
; race is one recorded ride - from the start line INTO the loop (Entry),
; round the loop (Shared, ridden every lap), the loop's closing stretch back
; to where the laps join (Return), and on the last lap the branch to the
; finish (Finish). Recorded with the read-only tools, game running:
;   1. At the start line, facing the direction of travel:
;        python tools/capture_race_point.py <pid>      -> start point X/Y/Z
;        python tools/capture_race_heading.py <pid>    -> GridHeading
;   2. Where the host waits, a few metres off the line, facing the approach:
;        python tools/capture_race_point.py <pid>      -> host point
;        python tools/capture_race_heading.py <pid>    -> HostHeading
;   3. python tools/record_player_course.py <pid>
;      then ride: start line -> round the loop TWICE at racing pace -> to the
;      finish (the finish may be the start line itself). Ctrl+C stops; the
;      capture lands under analysis/player-courses/.
;   4. Hand the capture over; tools/build_segmented_circuit.py turns it into
;      the four node sections and the gates below.
; Title, laps, field size and stakes are yours to set.

[Route]
; The course is policed for the whole race, not only at the start.
ContinuousClearance=1
Mode=Circuit
; Who waits at the line: MaryBeth, Sadie, Charles, Uncle, Karen, Pearson, Arthur or John.
; John rides Rachel, his own seal brown Thoroughbred; Arthur his blood bay (the
; field then spawns no blood bays); any other host the brindle. Ranks follow the
; host's own [OpponentDifficulty] entry in TheJockeyClub.ini, as at every station.
; Host= hosts in both chapters; Era= says which chapter the station is there in.
Host=John
Title=Thoroughbred Circuit
TitleZh=纯血马绕圈赛
StartPoint=thoroughbred_circuit_start_01
FinishPoint=thoroughbred_circuit_finish_01
HostPoint=thoroughbred_host_01
HostHeading=TODO
GridHeading=TODO
; Every entrant, the host included, rides a Thoroughbred; the player must too
; (blood bay, dapple grey, black chestnut, reverse dapple black, brindle, or Rachel).
Breed=Thoroughbred
FieldMin=3
FieldMax=5
; Jockey speed uses the host's ability band; acceleration is each horse's own.
; The host's earned edge, in speed levels (0.5 = half a level, as at New Austin).
HostSpeedLevelBonus=0.5
RewardMultiplier=Distance
StakeMultiplier=Distance

[Point.thoroughbred_circuit_start_01]
Name=Thoroughbred Circuit Start
NameZh=纯血马绕圈赛起点
X=TODO
Y=TODO
Z=TODO

[Point.thoroughbred_circuit_finish_01]
Name=Thoroughbred Circuit Finish
